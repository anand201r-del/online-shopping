# Copy this file to .env and put in your MySQL password. Never commit .env.

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=shopping_db

# Comma-separated usernames allowed to open /admin
ADMIN_USERS=admin,anand

# Optional: a fixed key keeps people logged in when the server restarts
# SECRET_KEY=any-long-random-text
